  <header class="bg-white shadow-lg border-b border-gray-200">
    <nav class="container mx-auto px-6 py-4 flex items-center justify-between">
      <!-- Left side navigation links -->
      <div class="flex space-x-6">
        <a href="/" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-300 ease-in-out transform hover:scale-105">airbnb</a>
       
       <% if(isLoggedIn) { %>
         <a href="/homes" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-300 ease-in-out transform hover:scale-105">Homes</a>
          <a href="/favourites" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-300 ease-in-out transform hover:scale-105">Favourites</a>
          <a href="/host/host-homes" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-2 rounded-lg transition duration-300 ease-in-out transform hover:scale-105">Host Homes</a>
          <a href="/host/add-home" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-300 ease-in-out transform hover:scale-105">Add Home</a>
         <% } %>
      </div>
     
      <!-- Right side login/signup -->
      <div class="flex space-x-4">
