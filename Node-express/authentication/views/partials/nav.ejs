                     <% if(isLoggedIn) { %>
        <form action="/logout" method="POST">
<input type="submit" value="Logout" class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-300 ease-in-out transform hover:scale-105" />
<% } else { %>
 <a href="/login" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-300 ease-in-out transform hover:scale-105">Login</a>

<%} %>
        </form>
