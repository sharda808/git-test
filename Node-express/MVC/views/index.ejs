<%- include('partials/head') %>
</head>
<body class="min-h-screen bg-gray-100">
  <%- include('partials/nav') %>

  <main class="py-12 px-4">
    <div class="container mx-auto max-w-7xl">
      <h1 class="text-4xl font-bold text-blue-600 mb-8 text-center tracking-tight">Welcome to Airbnb</h1>

      <!-- Flex / Grid container for home cards -->
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <% if (homes && homes.length > 0) { %>
          <% homes.forEach(home => { %>
            <div class="bg-white shadow-lg rounded-2xl overflow-hidden hover:shadow-2xl transition-transform duration-300 hover:-translate-y-2 border border-gray-100">
              
              <!-- Home photo -->
              <img 
                src="<%= home.photoUrl %>" 
                alt="<%= home.houseName %>" 
                class="w-full h-48 object-cover"
              />

              <!-- Home details -->
              <div class="p-6">
                <h2 class="text-2xl font-semibold text-gray-900 mb-2"><%= home.houseName %></h2>

                <p class="text-gray-700 mb-1">
                  <span class="font-semibold">Location:</span> <%= home.location %>
                </p>

                <p class="text-gray-700 mb-1">
                  <span class="font-semibold">Price:</span> <%= home.price %>/night
                </p>

                <p class="text-yellow-500 font-semibold mb-3">
                  <span class="text-gray-700">Rating:</span> ⭐ <%= home.rating %>
                </p>

                <button class="mt-2 w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 rounded-lg transition duration-300">
                Book Now
                </button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="col-span-full text-center text-gray-600 text-lg">No homes available yet.</p>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>
 
