<%- include('partials/head') %>
</head>
<body class="min-h-screen bg-gray-100">
<%- include('partials/nav') %>
    <h1 class="text-3xl font-bold text-gray-800 mb-6 text-center">🏡 Add Your Home</h1>
<div class="flex justify-center">
    <form 
      action="/host/add-home"
      method="POST"
      class="space-y-5"
    >
      <!-- House Name Field -->
      <div>
        <label for="houseName" class="block text-gray-700 font-medium mb-2">
          Name of your house
        </label>
        <input 
          type="text"
          id="houseName"
          name="houseName"
          placeholder="e.g., Cozy Cottage"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200"
          required
        />
      </div>

      <!-- Submit Button -->
      <div class="text-center">
        <input 
          type="submit" 
          value="Add Home"
          class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg cursor-pointer transition duration-300"
        />
      </div>
    </form>
  </div>
</main>
</body>
</html>
