<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 to-blue-100 flex flex-col">
<%- include('../partials/nav')%>
  <main class="py-12 px-4 flex-1">
    <div class="container mx-auto max-w-7xl">
      <h1 class="text-4xl font-bold text-blue-700 mb-16 text-center">Here is your home</h1>
      <div class="bg-white rounded-xl shadow-md border border-blue-100 w-full flex flex-col md:flex-row p-10 md:p-16 items-center gap-12">
        <img 
          src="<%= home.photoUrll %>" 
          alt="<%= home.houseName %>" 
          class="w-full max-w-lg h-96 object-cover object-center rounded-xl shadow md:mr-12"
          loading="lazy">
        <div class="flex-1 flex flex-col space-y-6">
          <h2 class="text-3xl md:text-4xl font-bold text-blue-700 mb-2"><%= home.houseName %></h2>
          <p class="text-lg text-gray-600"><span class="font-semibold">Location:</span> <%= home.location %></p>
          <p class="text-lg text-gray-600"><span class="font-semibold">Price:</span> <span class="text-blue-700 font-bold">Rs<%= home.price %></span></p>
          <div class="flex items-center mt-2">
            <span class="text-yellow-400 text-2xl mr-2">★</span>
            <span class="text-gray-800 font-medium text-xl mr-2"><%= home.rating %></span>
            <span class="text-gray-500 text-base">/ 5</span>
          </div>
          <div class="space-y-4">
<%- include('../partials/add-to-favourite',{home:home}) %>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>