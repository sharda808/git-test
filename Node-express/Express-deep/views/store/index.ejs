<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 to-blue-100 flex flex-col">
<%- include('../partials/nav')%>
  <main class="py-12 px-4">
    <div class="container mx-auto max-w-7xl">
      <h1 class="text-4xl font-bold text-blue-700 mb-16 text-center">Welcome to Hamar airbnb</h1>
      <div class="flex flex-wrap gap-8 justify-center">
        <% if(!homes || homes.length === 0) { %>
          <div class="text-base italic text-gray-400 px-2 text-center w-full">No homes added yet. </div>
        <% } else { %>
          <% homes.forEach(home => { %>
            <div class="bg-white rounded-xl shadow-md border border-blue-100 max-w-xs w-full flex flex-col overflow-hidden transition-transform hover:scale-105">
              <img src="<%= home.photoUrll %>" alt="<%= home.houseName %>" class="h-56 w-full object-cover object-center" loading="lazy">
              <div class="p-6 flex flex-col flex-1">
                <h2 class="text-2xl font-bold text-blue-700 mb-2"><%= home.houseName %></h2>
                <p class="text-gray-600 mb-1"><span class="font-semibold">Location:</span> <%= home.location %></p>
                <p class="text-gray-600 mb-1"><span class="font-semibold">Price:</span> Rs<%= home.price %></p>
                <div class="flex items-center mt-2">
                  <span class="text-yellow-400 text-xl mr-2">★</span>
                  <span class="text-gray-800 font-medium mr-2"><%= home.rating %></span>
                  <span class="text-gray-500 text-sm">/ 5</span>
                </div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>