<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-gray-100 ">
<%- include('../partials/nav')%>
  <main class="py-12 px-4">
    <div class="conatiner mx-auto max-w-7xl">
    <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Add your Home</h1>
    <form action="/host/add-home" method="POST" class="space-y-4">
      <input 
        type="text"
        name="houseName"
        placeholder="Name of your house"
        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-600 transition"
      />
        <input 
        type="text"
        name="price"
        placeholder="Daily rent of your home"
        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-600 transition"
      />
        <input 
        type="text"
        name="location"
        placeholder="Where is your home"
        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-600 transition"
      />
        <input 
        type="text"
        name="rating"
        placeholder="Rating of the house"
        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-600 transition"
      />
        <input 
        type="text"
        name="photoUrl"
        placeholder=" upload a photo"
        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-600 transition"
      />
            <textarea 
        type="text"
        name="description"
        placeholder="Describe your house"
        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-600 transition"
        rows="4"></textarea>
      
      <input 
        type="submit" 
        value="Add Home" 
        class="w-full py-2 px-4 bg-blue-600 text-white   font-semibold rounded-md hover:bg-blue-700 transition"
      >
    </form>
  </div>
</main>
</body>
</html>