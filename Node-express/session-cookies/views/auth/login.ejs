<%- include('../partials/head')%>
</head>
<body class="min-h-screen bg-gray-100">
<%- include('../partials/nav') %>
    <h1 class="text-3xl font-bold text-blue-600 mb-6 text-center mt-8">Login Here</h1>

   <form 
  action="/login" 
  method="POST"
  class="flex flex-col items-center space-y-5"
>

           <input 
          type="email"
            name="email"
       
          placeholder="Enter your Email "
          class="w-1/2 px-4 py-2 border border-gray-300 rounded-lg text-center bg-white " 
       
        />
    
   <input 
          type="password"
                  name="password"
                     
          placeholder="Enter your password "
          class="w-1/2 px-4 py-2 border border-gray-300 rounded-lg text-center bg-white " 
     
        />
    <div class="flex justify-center">
        <input 
        type="submit"
        value="Login"
        class="bg-blue-500 hover:bg-blue-600 text-white font-semibold p-2 rounded-lg trasition-duration-300 ease-in-out transform hover:scale-105 cursor:pointer"
        >
      </div>
    </form>
  </div>

</body>
</html>