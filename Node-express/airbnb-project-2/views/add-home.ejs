<%- include('partials/head')%>
</head>
<body class="min-h-scrren bg-gray-100">
<%- include('partials/nav')%>
 <h1 class="text-4xl font-bold text-bold text-blue-600 mb-8 text-center"></h1>
 <!-- jb koi data lekr request jati to post type ki  request jati hia  -->
  <div class="flex justify-center">
 <form action="/host/add-home" method="POST" class="w-3xl max-w-md">
<input type="text"
name="houseName"
 placeholder="Name of your house"
 class="w-full px-4 py-2 mb-4 border border-gray-300 rounded-lg  bg-white focus:outline-none focus:border-blue-500"/>

 
  <input type="text"
name="price"
 placeholder="Daily rent of your home"
 class="w-full px-4 py-2 mb-4 border border-gray-300 rounded-lg  bg-white focus:outline-none focus:border-blue-500"/>

    <input type="text"
name="location"
 placeholder="Where is your Home"
 class="w-full px-4 py-2 mb-4 border border-gray-300 rounded-lg  bg-white focus:outline-none focus:border-blue-500"/>

      <input type="text"
name="rating"
 placeholder="Raitng of the house"
 class="w-full px-4 py-2 mb-4 border border-gray-300 rounded-lg  bg-white focus:outline-none focus:border-blue-500"/>
      <input type="text"
name="photoUrl"
 placeholder="Upload a photo"
 class="w-full px-4 py-2 mb-4 border border-gray-300 rounded-lg  bg-white focus:outline-none focus:border-blue-500"/>

   <div class="flex justify-center">
 <input 

 type="submit"
 class="bg-blue-500 hover:bg-blue-600 text-white
 font-semibold py-2 px-4 
 rounded-lg  p-2 transition duration-300 ease-in-out 
  transform hover:scale-105 cursor-pointer"
 value="Add Home">
</div>
 </form>
 </div>
</main>
</body>
</html>