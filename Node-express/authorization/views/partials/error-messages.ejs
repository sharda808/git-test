<% if (typeof errorMessages !== 'undefined' && errorMessages.length > 0) { %>
  <div class="w-1/2 mb-4">
    <ul class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg list-disc list-inside space-y-1 shadow-md">
      <% errorMessages.forEach(errorMessage => { %>
        <li class="pl-2"><%= errorMessage %></li>
      <% }) %>
    </ul>
  </div>
<% } %>