<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-gray-100">
  <%- include('../partials/nav') %>

  <main class="py-12 px-4">
    <div class="container mx-auto max-w-7xl">
      <h1 class="text-4xl font-bold text-blue-600 mb-8 text-center tracking-tight">
        Analytics Dashboard
      </h1>

      <!-- Analytics Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Total Homes Card -->
        <div class="bg-white shadow-lg rounded-xl p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Total Homes</p>
              <p class="text-3xl font-bold text-blue-600 mt-2"><%= analytics.totalHomes %></p>
            </div>
            <div class="bg-blue-100 rounded-full p-3">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Total Revenue Card -->
        <div class="bg-white shadow-lg rounded-xl p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Total Revenue</p>
              <p class="text-3xl font-bold text-green-600 mt-2">Rs<%= analytics.totalRevenue %></p>
            </div>
            <div class="bg-green-100 rounded-full p-3">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Average Price Card -->
        <div class="bg-white shadow-lg rounded-xl p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Average Price</p>
              <p class="text-3xl font-bold text-purple-600 mt-2">Rs<%= analytics.averagePrice %></p>
            </div>
            <div class="bg-purple-100 rounded-full p-3">
              <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Average Rating Card -->
        <div class="bg-white shadow-lg rounded-xl p-6 border border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Average Rating</p>
              <p class="text-3xl font-bold text-yellow-600 mt-2">⭐ <%= analytics.averageRating %></p>
            </div>
            <div class="bg-yellow-100 rounded-full p-3">
              <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Location Statistics -->
      <% if (Object.keys(analytics.locationStats).length > 0) { %>
      <div class="bg-white shadow-lg rounded-xl p-6 mb-8 border border-gray-200">
        <h2 class="text-2xl font-bold text-gray-800 mb-4">Homes by Location</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% Object.entries(analytics.locationStats).forEach(([location, count]) => { %>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
              <p class="text-gray-600 text-sm">📍 <%= location %></p>
              <p class="text-xl font-bold text-blue-600 mt-1"><%= count %> home<%= count !== 1 ? 's' : '' %></p>
            </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- All Homes List -->
      <div class="bg-white shadow-lg rounded-xl p-6 border border-gray-200">
        <h2 class="text-2xl font-bold text-gray-800 mb-4">All Your Homes</h2>
        <% if (analytics.homes.length === 0) { %>
          <p class="text-gray-600 text-center py-8">No homes registered yet. <a href="/host/add-home" class="text-blue-600 hover:underline">Add your first home</a></p>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Home Name</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rating</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% analytics.homes.forEach(home => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= home.houseName %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= home.location %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Rs<%= home.price %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-yellow-600">⭐ <%= home.rating %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>

